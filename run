#! /usr/bin/env python3
# -*- coding: utf-8 -*-
"""Bake monitoring module."""

# %% IMPORTS
# - python standard libraries
import argparse
import configparser
import os
import time
import logging
from pathlib import Path
from datetime import datetime

# - phidgets management
from Phidget22.Devices.TemperatureSensor import TemperatureSensor
from Phidget22.Devices.LCD import LCD, LCDFont
import daemon

# - database management
from influxdb_client import InfluxDBClient, Point
from influxdb_client.client.write_api import SYNCHRONOUS

import yaml

# %% GLOBAL VARIABLES
PASQWATCH_ROOT = Path(os.path.dirname(__file__))
CONFIGS_PATH = PASQWATCH_ROOT / "configs"
CONFIG_FILE_PATH = CONFIGS_PATH / "config.yml"
CONFIG = {}
DATABASE = None
TEMP_SENSORS = []
START_TIME = time.time()
LCD_STRINGS = []
LCD_MODEL = "{name:<5}:{value:.1f}{unit}"
LCD_HANDLER = LCD()

# %% LOGGER
# setup format
fmt = "[%(asctime)s] - %(name)s - %(levelname)s - %(message)s"
# config : default level set to Warning
logging.basicConfig(format=fmt, datefmt="%Y-%m-%d %H:%M:%S", level=logging.WARNING)
logger = logging.getLogger(__name__)
logger.setLevel(logging.DEBUG)
logger.debug("debug mode enabled")

# %% FUNCTIONS


def load_config():
    global CONFIG_FILE_PATH, CONFIG
    # logger
    logger = logging.getLogger(__name__)
    logger.debug(f"loading config file {CONFIG_FILE_PATH}")
    # load config
    with CONFIG_FILE_PATH.open() as file:
        CONFIG = yaml.safe_load(file)


def setup_influx_client():
    """Create the connetion to the database."""
    global CONFIG, DATABASE
    # logger
    logger = logging.getLogger(__name__)
    logger.debug(f"setting up influxdb client")
    # setup influx client
    dbconf = CONFIG["influxdb"]
    DATABASE = InfluxDBClient(
        url=f'http://{dbconf["host"]}:{dbconf["port"]}',
        org=dbconf["org"],
        token=dbconf["token"],
    )


def setup_temperature_sensors():
    global CONFIG, TEMP_SENSORS, LCD_HANDLER
    # - get logger
    logger = logging.getLogger(__name__)
    # - loop on temperature sensors
    for conf in CONFIG["temperature sensors"]:
        # initial checkup
        if not conf["enabled"]:
            continue
        # logger
        logger.debug(
            "add temperature sensor > port : {port} | chan : {channel} | loc : {location}".format(
                **conf
            )
        )
        # init
        ts = TemperatureSensor()
        ts.setHubPort(conf["port"])
        ts.setChannel(conf["channel"])
        ts.tags = {"location": conf["location"], "data_unit": "°C"}
        ts.display_name = conf["display name"]
        ts.display_unit = "C"
        ts.alarm = conf["alarm"]
        ts.min = conf["min"]
        ts.max = conf["max"]
        ts.openWaitForAttachment(1000)
        # append to list
        TEMP_SENSORS.append(ts)
    # - lcd ?
    if CONFIG["global"]["lcd"]:
        LCD_HANDLER.openWaitForAttachment(1000)
        LCD_HANDLER.setBacklight(0.2)


def _write_point(fields, extra_tags=dict(), current_time=None):
    global CONFIG, DATABASE
    # get info from config
    bucket = CONFIG["global"]["bucket"]
    global_tags = CONFIG["global"]["tags"]
    measurement = CONFIG["global"]["measurement"]
    # prepare tags
    tags = {}
    tags.update(global_tags)
    tags.update(extra_tags)
    # get current time
    if current_time is None:
        current_time = datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")
    # prepare point
    point = Point.from_dict(
        {
            "measurement": measurement,
            "tags": tags,
            "time": current_time,
            "fields": fields,
        }
    )
    # write to DB
    write_api = DATABASE.write_api(write_options=SYNCHRONOUS)
    write_api.write(bucket, DATABASE.org, point)


def _measure():
    global TEMP_SENSORS, LCD_STRINGS, LCD_MODEL, CONFIG
    current_time = datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")
    LCD_STRINGS = []
    # temperature
    for ts in TEMP_SENSORS:
        new_temperature = -1
        try:
            new_temperature = ts.getTemperature()
            _write_point(
                fields={"temperature": new_temperature},
                extra_tags=ts.tags,
                current_time=current_time,
            )
        except Exception as e:
            logger.error(e)
        if CONFIG["global"]["lcd"]:
            str = LCD_MODEL.format(
                name=ts.display_name, value=new_temperature, unit=ts.display_unit
            )
            LCD_STRINGS.append(str)


def _update_LCD():
    global LCD_STRINGS, LCD_HANDLER
    if not CONFIG["global"]["lcd"]:
        return
    line = 0
    line_height = 10
    line_width = 65
    font = LCDFont.FONT_5x8
    for str in LCD_STRINGS:
        x = (line % 2) * line_width
        y = (line // 2) * line_height
        LCD_HANDLER.writeText(font, x, y, str)
        line += 1
    LCD_HANDLER.flush()


def start_monitoring():
    global START_TIME, CONFIG
    # get config
    max_duration = CONFIG["global"]["max_duration"]
    data_interval = CONFIG["global"]["data_interval"]
    last_measurement = time.time()
    while True:
        # check if finished
        if max_duration and time.time() - START_TIME > max_duration:
            duration = time.time() - START_TIME
            logger.debug(f"measurement stopped after {duration} seconds")
            break
        # new measurement ?
        if time.time() - last_measurement > data_interval:
            last_measurement = time.time()
            t0 = time.time()
            _measure()
            _update_LCD()
            t1 = time.time()
            logger.debug(f"measurement done in {t1-t0}s")
        time.sleep(data_interval / 20)


# %% MAIN
def main():
    global CONFIG, CONFIG_FILE_PATH, DATABASE
    load_config()
    setup_influx_client()
    setup_temperature_sensors()
    start_monitoring()


# %% RUN
if __name__ == "__main__":
    # -- get arguments
    # configure parser
    parser = argparse.ArgumentParser()
    parser.add_argument("-c", "--config", type=str, help="config file name")
    parser.add_argument(
        "-d", "--deamon", action="store_true", help="Start pasqwatch as a deamon"
    )

    # process config argument
    args = parser.parse_args()
    conf_name = args.config
    if conf_name is not None:
        CONFIG_FILE_PATH = CONFIGS_PATH / conf_name

    # -- start
    if args.deamon is True:
        with daemon.DaemonContext():
            main()
    else:
        main()
