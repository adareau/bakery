# %% SAES PAYLOAD DICT
SAES_PAYLOAD_DICT = {
    "SERIAL_NUMBER": [48, 80],
    "IOUT": [80, 112],  # nA
    # "VOUT": [112, 128],  # V
    # "VIN": [128, 144],  # dV
    "TEMPERATURE": [160, 176],  # Kelvin
